# Déjala vacía en local para usar SQLite (buscame.db).
# En Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Cadena aleatoria larga en producción.
SECRET_KEY=cambia-esto

# Bucket S3 de Railway para las fotos. Si S3_BUCKET queda vacía,
# las fotos se guardan en la carpeta local uploads/ (desarrollo).
# En Railway conecta las referencias del bucket:
#   S3_BUCKET            = ${{Bucket.BUCKET}}
#   S3_ENDPOINT          = ${{Bucket.ENDPOINT}}
#   S3_ACCESS_KEY_ID     = ${{Bucket.ACCESS_KEY_ID}}
#   S3_SECRET_ACCESS_KEY = ${{Bucket.SECRET_ACCESS_KEY}}
#   S3_REGION            = ${{Bucket.REGION}}
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Solo para desarrollo local sin bucket (opcional).
UPLOAD_FOLDER=
